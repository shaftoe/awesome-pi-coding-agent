{
  "name": "awesome-pi-coding-agent",
  "version": "2.7.2",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "discover": "bun run src/discover/index.ts",
    "filter": "bun run src/filter/index.ts",
    "process": "bun run src/process/index.ts",
    "generate": "bun run src/generate/index.ts",
    "pipeline": "bun run discover && bun run filter && bun run process && bun run generate",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test",
    "validate-prompt": "bun run src/cli/validate-prompt.ts",
    "blacklist": "bun run src/cli/blacklist.ts",
    "add-url": "bun run src/cli/add-url.ts",
    "lookup": "bun run src/cli/lookup.ts",
    "clean": "rm -rf data/ .cache/",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@alexanderfortin/semantic-release-keep-a-changelog": "^0.4.13",
    "@biomejs/biome": "^2.5.12",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "bun-types": "^1.4.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "semantic-release": "^25.0.9"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.4"
  }
}
