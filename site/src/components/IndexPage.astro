---
import { getCategories, getStats, loadAllEntries } from "../lib/data";

// BUILD_DATE is injected at build time via Vite's define in astro.config.mjs
declare const BUILD_DATE: string;

const entries = loadAllEntries();
// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const stats = getStats(entries);
// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const categories = getCategories(entries);
// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const lastUpdated = typeof BUILD_DATE === "string" ? BUILD_DATE : "";
---

<div class="stats-bar">
  <strong>{stats.total.toLocaleString()} resources</strong>
  <a
    href="https://github.com/shaftoe/awesome-pi-coding-agent"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Star awesome-pi-coding-agent on GitHub"
  >
    <img
      alt="GitHub stars"
      src="https://img.shields.io/github/stars/shaftoe/awesome-pi-coding-agent?style=social&label=Star"
      height="20"
      loading="lazy"
      decoding="async"
    />
  </a>
</div>

{lastUpdated && (
  <p class="last-updated">Last updated: {lastUpdated}</p>
)}

<global-search-bar class="global-search-bar">
  <div class="global-search-bar-inner">
    <global-search-input class="search-box">
      <input type="search" placeholder="Search extensions, themes, videos, articles…" />
      <span class="search-count"></span>
    </global-search-input>
    <button type="button" class="clear-search" style="display:none">← Back to categories</button>
  </div>
</global-search-bar>

<div class="global-search-results entry-grid" style="display:none"></div>
<div class="global-search-empty" style="display:none">
  <p>No results found.</p>
</div>

<div class="category-grid">
  {categories.map((cat) => (
    <a href={cat.href} class="category-card">
      <div class="card-header">
        <span style="font-size:1.5rem">{cat.icon}</span>
        <h2>{cat.title}</h2>
        <span class="count">{cat.entries.length}</span>
      </div>
      <p class="card-desc">{cat.description}</p>
    </a>
  ))}
</div>

<script>
	import { searchEntries, type SearchEntry } from "../lib/search";
	const CATEGORY_ICONS: Record<string, string> = {
		extension: '🔌', theme: '🎨', video: '🎬', article: '📰', misc: '📦',
	};

	function escapeHtml(s: string): string {
		return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	}

	function escapeRegex(s: string): string {
		return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	}

	function highlightText(text: string, query: string): string {
		if (!query.trim()) return escapeHtml(text);
		const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
		let result = escapeHtml(text);
		for (const term of terms) {
			const regex = new RegExp(`(${escapeRegex(term)})`, 'gi');
			result = result.replace(regex, '<mark>$1</mark>');
		}
		return result;
	}

	function truncateText(s: string, len: number): string {
		return s.length > len ? s.slice(0, len) + '…' : s;
	}

	function renderResults(container: HTMLElement, results: SearchEntry[], query: string): void {
		container.innerHTML = results
			.map((r) => {
				const icon = CATEGORY_ICONS[r.c] || '📄';
				const popHtml = r.p ? `<span>${r.p}</span>` : '';
				const categoryLabel = r.c.charAt(0).toUpperCase() + r.c.slice(1);
				return `<a href="${r.u}" target="_blank" rel="noopener noreferrer" class="entry-card">
					<h3>${icon} ${highlightText(r.n, query)}</h3>
					<p class="desc">${highlightText(truncateText(r.d, 200), query)}</p>
					<div class="meta">
						<span>${categoryLabel}</span>
						${popHtml}
						<span class="result-external" style="margin-left:auto">↗</span>
					</div>
				</a>`;
			})
			.join('');
	}

	class GlobalSearchInput extends HTMLElement {
		connectedCallback() {
			const input = this.querySelector<HTMLInputElement>('input[type="search"]')!;
			const resultsContainer = document.querySelector<HTMLElement>('.global-search-results');
			const emptyEl = document.querySelector<HTMLElement>('.global-search-empty');
			const countEl = this.querySelector<HTMLElement>('.search-count');
			if (!resultsContainer || !emptyEl || !countEl) return;

			let debounceTimer: ReturnType<typeof setTimeout>;

			const doSearch = async () => {
				const query = input.value.trim();
				const url = new URL(window.location.href);
				if (query) {
					url.searchParams.set('q', query);
				} else {
					url.searchParams.delete('q');
				}
				history.replaceState(null, '', url.toString());

				if (!query) {
					showCategoryGrid();
					return;
				}

				document.querySelector<HTMLElement>('.category-grid')!.style.display = 'none';
				document.querySelector<HTMLElement>('.clear-search')!.style.display = '';
				try {
					const { entries: results, total } = await searchEntries(query);
					if (input.value.trim() !== query) return;
					renderResults(resultsContainer, results, query);
					emptyEl.textContent = 'No results found.';
					emptyEl.style.display = total === 0 ? '' : 'none';
					resultsContainer.style.display = total === 0 ? 'none' : '';
					countEl.textContent = `${total} result${total === 1 ? '' : 's'}`;
				} catch {
					if (input.value.trim() !== query) return;
					emptyEl.textContent = 'Search could not load. Please try again.';
					emptyEl.style.display = '';
					resultsContainer.style.display = 'none';
					countEl.textContent = '';
				}
			};

			input.addEventListener('input', () => {
				clearTimeout(debounceTimer);
				debounceTimer = setTimeout(doSearch, 150);
			});

			// Store reference for external activation
			(this as any)._doSearch = doSearch;
			(this as any)._input = input;
		}
	}

	function showCategoryGrid(): void {
		const resultsContainer = document.querySelector<HTMLElement>('.global-search-results');
		const emptyEl = document.querySelector<HTMLElement>('.global-search-empty');
		const grid = document.querySelector<HTMLElement>('.category-grid');
		const backBtn = document.querySelector<HTMLButtonElement>('.clear-search');
		if (resultsContainer) resultsContainer.style.display = 'none';
		if (emptyEl) emptyEl.style.display = 'none';
		if (grid) grid.style.display = '';
		if (backBtn) backBtn.style.display = 'none';
		const url = new URL(window.location.href);
		url.searchParams.delete('q');
		history.replaceState(null, '', url.toString());
	}

	function showSearchView(query: string): void {
		const resultsContainer = document.querySelector<HTMLElement>('.global-search-results');
		const grid = document.querySelector<HTMLElement>('.category-grid');
		const backBtn = document.querySelector<HTMLButtonElement>('.clear-search');
		if (resultsContainer) resultsContainer.style.display = '';
		if (grid) grid.style.display = 'none';
		if (backBtn) backBtn.style.display = '';

		const inputComp = document.querySelector('global-search-input') as any;
		if (inputComp?._input) {
			inputComp._input.value = query;
		}
		if (inputComp?._doSearch) {
			inputComp._doSearch();
		}
	}

	class GlobalSearchBar extends HTMLElement {
		connectedCallback() {
			const clearBtn = this.querySelector<HTMLButtonElement>('.clear-search');
			if (clearBtn) {
				clearBtn.addEventListener('click', () => {
					const inputComp = document.querySelector('global-search-input') as any;
					if (inputComp?._input) {
						inputComp._input.value = '';
					}
					showCategoryGrid();
				});
			}

			// Check URL for ?q= on load
			const params = new URLSearchParams(window.location.search);
			const q = params.get('q');
			if (q) {
				showSearchView(q);
			}
		}
	}

	customElements.define('global-search-input', GlobalSearchInput);
	customElements.define('global-search-bar', GlobalSearchBar);

	// Also handle browser back/forward navigation
	window.addEventListener('popstate', () => {
		const params = new URLSearchParams(window.location.search);
		const q = params.get('q');
		if (q) {
			showSearchView(q);
		} else {
			showCategoryGrid();
		}
	});
</script>
